# Client JS packs and demo contract WASMs are committed (like rustSDK pkg/).
# Nested wasm-pack "*" gitignores stay untracked:
ceps-client-wasm/pkg/.gitignore
ceps-client-wasm/pkg-nodejs/.gitignore
# Schema-only packs are build artifacts (make nodejs-schema / web-schema):
ceps-client-wasm/pkg-schema/
ceps-client-wasm/pkg-nodejs-schema/

# llvm-cov output
/coverage/
